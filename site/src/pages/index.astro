---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services, serviceHref } from '../data/services';

const affordablePoints = [
  'Sliding scale fees available',
  'In-person sessions in Newport Beach, telehealth throughout California',
  'Evening and weekend availability',
  'Trained in Emotionally Focused Therapy (EFT), currently in my second year of formal training in ISTDP (Intensive Short-Term Dynamic Psychotherapy), and informed by attachment work',
];
---

<BaseLayout
  title="Anne Warner Therapy | Psychotherapist in Newport Beach, CA"
  description="Affordable, insight oriented psychotherapy for individuals, couples, and teens in Newport Beach and Orange County. Christian therapy available. Schedule a free consultation."
>
  <!-- Hero -->
  <section class="hero" id="top">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Psychotherapy &middot; Newport Beach, CA</p>
        <h1 class="display">It&rsquo;s never too<br>late to heal.</h1>
        <p class="lede">Affordable, insight oriented psychotherapy for individuals, couples, and teens in Newport Beach, CA.</p>
        <div class="hero-cta">
          <a class="btn btn-dark" href="#contact">Schedule a Free Consultation</a>
        </div>
      </div>
      <div class="hero-art" role="img" aria-label="Illustration placeholder, reserved for commissioned artwork">
        <span class="hero-art-label">Illustration placeholder</span>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="about" id="about">
    <div class="wrap about-inner">
      <div class="about-portrait" role="img" aria-label="Portrait placeholder for Anne Warner">
        <span class="about-portrait-label">Portrait &mdash; Anne Warner</span>
      </div>
      <div class="about-copy">
        <p class="eyebrow eyebrow-olive">About Anne</p>
        <h2 class="display display-md about-heading">Psychotherapy in Newport Beach, CA</h2>
        <p>I&rsquo;m Anne Warner, an Associate Marriage &amp; Family Therapist (AMFT #150232, supervised by Susan Beisner, LMFT #46150, and Dr. Michele Willingham, PSY #15849) working with individuals, couples, and teens across Newport Beach and Orange County, in person and by telehealth throughout California.</p>
        <p>I seek to step into the trenches with you. I believe healing begins when another person bears witness to our deepest fears, hopes, and longings, and that most of us are carrying unconscious patterns that quietly shape our relationships and keep us stuck in cycles of disconnection. My work is to help you untangle those patterns, at a pace that feels safe, in a style that gets right to the point. You might be surprised by what you find, even in the first session.</p>
        <p>Therapy is never selfish. It&rsquo;s a chance to take care of your most precious resource, yourself.</p>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="services" id="services">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Areas of Focus</p>
        <h2 class="display display-md">Ways we can work together</h2>
      </div>

      <ul class="service-grid">
        {services.map((service, i) => (
          <ServiceCard
            index={String(i + 1).padStart(2, '0')}
            title={service.title}
            description={service.description}
            variant={service.variant}
            href={serviceHref(service.slug)}
          />
        ))}
      </ul>
    </div>
  </section>

  <!-- Affordable Therapy -->
  <section class="affordable">
    <div class="wrap affordable-inner">
      <div class="affordable-copy">
        <h2 class="display display-md">Affordable Therapy in Orange County</h2>
        <p>I offer sliding scale fees because I believe everyone deserves access to real care, not just people who happen to have the money for it. As an Associate Marriage and Family Therapist, I&rsquo;m able to offer rates that are often lower than a fully licensed practice, without cutting corners on the work itself.</p>
      </div>
      <ul class="affordable-list">
        {affordablePoints.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="statement">
    <div class="wrap">
      <h2 class="display display-lg">Ready to Connect?</h2>
      <p>Whether you&rsquo;re looking for yourself, you and your partner, or your teen, reach out. Let&rsquo;s see if it&rsquo;s a good fit. Schedule a free 15-minute consultation and we&rsquo;ll take it from there.</p>
      <a class="btn btn-cream" href="#contact">Get in Touch</a>
    </div>
  </section>
</BaseLayout>
