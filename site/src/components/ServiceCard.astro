---
interface Props {
  index: string;
  title: string;
  description: string;
  variant: 'plum' | 'clay' | 'olive' | 'lavender' | 'ink';
  href: string;
}

const { index, title, description, variant, href } = Astro.props;
const buttonVariant = variant === 'lavender' ? 'btn-outline-dark' : 'btn-outline-light';
---

<li class={`service-card service-card--${variant}`}>
  <span class="service-index">{index}</span>
  <h3>{title}</h3>
  <p>{description}</p>
  <a class={`btn ${buttonVariant}`} href={href} aria-label={`Read more about ${title}`}>Read More &rarr;</a>
</li>
